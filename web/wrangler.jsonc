// Despliegue en Cloudflare Workers como sitio estático. Ver docs/despliegue.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ctp-valdelasfuentes",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web/browser",
    // Cualquier ruta de Angular (/clasificacion, /acceso…) sirve index.html.
    "not_found_handling": "single-page-application",
  },
}
